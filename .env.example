# ── ArduiBlok Server Configuration ───────────────────────────
PORT=3000
JWT_SECRET=super_secret_arduiblok_jwt_key_change_me_in_production_2026

# ── SMTP Email Configuration for OTP Verification ────────────
# If SMTP is not configured or DEV_MOCK_OTP=true, OTP will also be logged in server console
DEV_MOCK_OTP=true

# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_google_app_password
# EMAIL_FROM="ArduiBlok Studio <no-reply@arduiblok.com>"

# Example for custom SMTP / cPanel / Mailgun / Brevo:
# SMTP_HOST=smtp.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="ArduiBlok Studio <support@yourdomain.com>"
